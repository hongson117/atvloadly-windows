diff --git a/internal/signing/flock_unix.go b/internal/signing/flock_unix.go
new file mode 100644
index 0000000..e7edda7
--- /dev/null
+++ b/internal/signing/flock_unix.go
@@ -0,0 +1,26 @@
+//go:build !windows
+
+package signing
+
+import (
+	"os"
+	"syscall"
+)
+
+// Platform shims for file locking (added for the Windows port).
+const (
+	oNoFollow = syscall.O_NOFOLLOW
+	lockSH    = syscall.LOCK_SH
+	lockEX    = syscall.LOCK_EX
+	lockNB    = syscall.LOCK_NB
+
+	// closeLockBeforeRemove: POSIX allows removing a directory whose files
+	// are still open, so the lock is kept until after removal.
+	closeLockBeforeRemove = false
+)
+
+var errWouldBlock = syscall.EWOULDBLOCK
+
+func flockFile(f *os.File, how int) error {
+	return syscall.Flock(int(f.Fd()), how)
+}
diff --git a/internal/signing/flock_windows.go b/internal/signing/flock_windows.go
new file mode 100644
index 0000000..ea14479
--- /dev/null
+++ b/internal/signing/flock_windows.go
@@ -0,0 +1,36 @@
+//go:build windows
+
+package signing
+
+import (
+	"os"
+
+	"golang.org/x/sys/windows"
+)
+
+// Windows emulation of flock(2) using LockFileEx. Windows has no O_NOFOLLOW;
+// symlink checks elsewhere (Lstat) still apply.
+const (
+	oNoFollow = 0
+	lockSH    = 1
+	lockEX    = 2
+	lockNB    = 4
+
+	// Windows cannot delete a file that is still open, so the workspace lock
+	// must be released before the directory is removed.
+	closeLockBeforeRemove = true
+)
+
+var errWouldBlock error = windows.ERROR_LOCK_VIOLATION
+
+func flockFile(f *os.File, how int) error {
+	var flags uint32
+	if how&lockEX != 0 {
+		flags |= windows.LOCKFILE_EXCLUSIVE_LOCK
+	}
+	if how&lockNB != 0 {
+		flags |= windows.LOCKFILE_FAIL_IMMEDIATELY
+	}
+	ol := new(windows.Overlapped)
+	return windows.LockFileEx(windows.Handle(f.Fd()), flags, 0, 1, 0, ol)
+}
